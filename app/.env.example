# Copy this file to .env and fill in your real values.
# Full scoring URL for your managed online endpoint, e.g.:
# https://ok-tool1-api.<region>.inference.ml.azure.com/score
AZURE_ENDPOINT_URL=

# Primary or secondary key from the endpoint's "Consume" tab in Azure ML Studio
AZURE_API_KEY=

# Optional: name of the deployment to target within the endpoint
# (matches `name:` in yellow-ok.yml, e.g. "yellow"). Leave blank to let
# Azure route to the endpoint's default/traffic-split deployment.
AZURE_DEPLOYMENT_NAME=yellow

# Optional: request timeout in seconds (matches request_timeout_ms: 180000 in yellow-ok.yml)
REQUEST_TIMEOUT_SECS=180
